# Text files are stored and checked out with LF on every platform. This is
# not a style preference: the conformance corpus and the reference vectors
# are byte contracts (include_bytes! embeds the working-tree bytes), so a
# CRLF checkout would silently change their SHA-256.
* text=auto eol=lf

# Binary fixtures whose SHA-256 is part of the crate contract: Annex-B
# streams and the reference-decoded planar pixels they must reproduce.
*.h264 binary
*.yuv binary

# The lockfile is generated by cargo and is LF by construction.
Cargo.lock text eol=lf
